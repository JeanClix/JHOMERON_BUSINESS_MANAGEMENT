# ============================================================
# AI Service - JHOMERON - Variables de entorno
# Copiar a .env y ajustar. NO commitear .env con credenciales reales.
# ============================================================

# Postgres - usa el rol ai_readonly (solo lectura, solo esquema ai.*)
# Ver backend/batch/src/main/resources/schemas/schema-ai.sql
DATABASE_URL=postgresql://ai_readonly:ai_readonly_local_dev@localhost:5432/jhomeron_batch

# LLM - OpenAI-compatible. En dev: NVIDIA API (integrate.api.nvidia.com), para
# probar modelos sin instalar nada local. En prod: vLLM u otro proveedor propio.
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_API_KEY=tu-nvidia-api-key
LLM_MODEL=deepseek-ai/deepseek-v4-flash-0731

# Límite de filas que el tool de SQL puede devolver al LLM (nunca el dataset completo)
SQL_TOOL_MAX_ROWS=200
