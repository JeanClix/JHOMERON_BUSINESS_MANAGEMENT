# ============================================================
# deploy/.env -- secretos de producción (copiar a .env en la VM, chmod 600).
# NUNCA commitear el .env real. Generar valores con: openssl rand -base64 32
# ============================================================

# Superusuario de Postgres (lo usan admin y batch)
POSTGRES_PASSWORD=

# Roles de solo lectura (creados por schema-bi.sql / schema-ai.sql con
# contraseñas de dev -- cambiarlos con ALTER ROLE, ver DEPLOY.md)
BI_READONLY_PASSWORD=
AI_READONLY_PASSWORD=

# Secreto JWT compartido por admin (emite) y reporting/ai (validan). 32+ chars.
JWT_SECRET=

# Origen(es) del frontend en Cloudflare Pages, separados por coma, sin "/" final
CORS_ORIGINS=https://jhomeron.pages.dev,https://app.example.com

# Token del túnel (Cloudflare Zero Trust -> Networks -> Tunnels -> Docker)
CLOUDFLARE_TUNNEL_TOKEN=

# SQL Server de SAP, alcanzable por Tailscale desde la VM
SQLSERVER_URL=jdbc:sqlserver://100.117.64.56:1433;databaseName=Jhomeron;encrypt=false;trustServerCertificate=true;
SQLSERVER_USERNAME=
SQLSERVER_PASSWORD=

# Versión que muestra el ML Service (la del registry local en Production)
ML_MODEL_VERSION=1
