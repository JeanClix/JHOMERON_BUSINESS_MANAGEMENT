# ============================================================
# Reporting Service - JHOMERON - Variables de entorno
# Copiar a .env y ajustar. NO commitear .env con credenciales reales.
# ============================================================

# Postgres - usa el rol bi_readonly (solo lectura, solo esquema bi.*)
# Ver backend/batch/src/main/resources/schemas/schema-bi.sql
DATABASE_URL=postgresql://bi_readonly:bi_readonly_local_dev@localhost:5432/jhomeron_batch

# Debe ser EXACTAMENTE el mismo valor que jwt.secret en
# backend/admin/src/main/resources/application.yaml (JWT_SECRET) -- admin
# emite el token, este servicio solo lo valida.
JWT_SECRET=jhomeron-dev-secret-cambiar-en-produccion-32+chars
JWT_ALGORITHM=HS256
