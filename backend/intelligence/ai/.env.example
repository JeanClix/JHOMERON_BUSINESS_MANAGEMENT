# ============================================================
# AI Service - JHOMERON - Variables de entorno
# Copiar a .env y ajustar. NO commitear .env con credenciales reales.
# ============================================================

# Postgres - usa el rol ai_readonly (solo lectura, solo esquema ai.*)
# Ver backend/batch/src/main/resources/schemas/schema-ai.sql
DATABASE_URL=postgresql://ai_readonly:ai_readonly_local_dev@localhost:5432/jhomeron_batch

# LLM - OpenAI-compatible. En dev: NVIDIA API (integrate.api.nvidia.com), para
# probar modelos sin instalar nada local. En prod: vLLM u otro proveedor propio.
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_API_KEY=tu-nvidia-api-key
LLM_MODEL=deepseek-ai/deepseek-v4-flash-0731
# Producción: OpenAI GPT-5.6 Luna (con razonamiento; LLM_REASONING_EFFORT
# vacío = default del modelo, "low" responde más rápido):
#   LLM_BASE_URL=https://api.openai.com/v1
#   LLM_API_KEY=sk-...
#   LLM_MODEL=gpt-5.6-luna
#   LLM_REASONING_EFFORT=low
LLM_REASONING_EFFORT=

# Proveedor del LLM (ver src/llm.py): "openai" = cualquier API compatible con
# OpenAI (Groq, xAI, OpenAI, NVIDIA) con LLM_BASE_URL / LLM_API_KEY;
# "anthropic" = Claude con el SDK oficial y ANTHROPIC_API_KEY. LLM_MODEL
# aplica a ambos, ej. LLM_MODEL=claude-haiku-4-5.
LLM_PROVIDER=openai
ANTHROPIC_API_KEY=tu-anthropic-api-key
# Solo Anthropic: tokens de razonamiento por llamada (0 = apagado, mín. 1024).
# Con Haiku 4.5 no mejoró las preguntas comparativas y encareció -- dejar en 0.
LLM_THINKING_BUDGET=0

# Límite de filas que el tool de SQL puede devolver al LLM (nunca el dataset completo)
SQL_TOOL_MAX_ROWS=40

# Solo para /recomendaciones/reactivacion. JWT_SECRET debe ser EXACTAMENTE
# el mismo valor que jwt.secret en backend/admin/.../application.yaml y que
# JWT_SECRET en backend/reporting/.env -- los tres servicios validan (o en
# el caso de admin, emiten) el mismo token.
JWT_SECRET=jhomeron-dev-secret-cambiar-en-produccion-32+chars
JWT_ALGORITHM=HS256
REPORTING_BASE_URL=http://localhost:8093

# Embeddings para la tool buscar_documentos (RAG sobre documentación
# empresarial, ver rag.* en schema-rag.sql). Si el proveedor de chat (LLM_*
# arriba) no ofrece embeddings (ej. Groq no los tiene), configura estas tres
# variables aparte; si se dejan vacías, se reusa LLM_BASE_URL/LLM_API_KEY.
EMBEDDING_BASE_URL=https://integrate.api.nvidia.com/v1
EMBEDDING_API_KEY=tu-nvidia-api-key
EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b
# Debe coincidir con VECTOR(n) en rag.chunk -- si cambias de modelo con otra
# dimensión, hay que migrar la columna.
EMBEDDING_DIMENSIONS=2048
RAG_TOOL_MAX_CHUNKS=6

# Enrutador previo con Jev (TypeSafe AI, ver src/enrutador.py): decide qué
# tools/secciones del prompt necesita cada pregunta antes de llamar al LLM,
# y responde "fuera de tema" sin gastar tokens de LLM. Apagado por defecto.
JEV_HABILITADO=false
TYPESAFE_API_KEY=tu-typesafe-api-key
JEV_MODELO=jev-latest
JEV_TIMEOUT_S=1.5
JEV_UMBRAL_TOOL=0.35
JEV_UMBRAL_SIN_TOOLS=0.85
